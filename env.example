# Redmine接続情報（必須）
REDMINE_URL=https://your-redmine.example.com
REDMINE_API_KEY=your_api_key_here

# オプション設定（空の場合はデフォルト動作）
# プロジェクトID（空=全プロジェクト、カンマ区切りで複数指定可: 598,631,728）
REDMINE_PROJECT_ID=

# 取得件数の上限（空=全件取得、数値を指定: 500）
REDMINE_MAX_ISSUES=

# ステータスフィルター（空=全ステータス、*=全て、open=オープンのみ、closed=完了のみ、またはID指定: 1,2,3）
REDMINE_STATUS_ID=
